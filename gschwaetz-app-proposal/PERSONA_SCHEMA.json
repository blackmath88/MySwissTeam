{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gschwaetz Argument Persona",
  "type": "object",
  "required": [
    "id",
    "display_name",
    "issue_id",
    "stance",
    "values",
    "reasons",
    "tradeoffs",
    "counterarguments",
    "uncertainties",
    "change_conditions",
    "sources",
    "reveal"
  ],
  "properties": {
    "id": {"type": "string"},
    "display_name": {"type": "string"},
    "issue_id": {"type": "string"},
    "stance": {
      "type": "object",
      "properties": {
        "direction": {
          "enum": ["lean_yes", "lean_no", "mixed", "undecided"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "summary": {"type": "string"}
      }
    },
    "values": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "weight": {"type": "number", "minimum": 0, "maximum": 1},
          "explanation": {"type": "string"}
        }
      }
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "source_ids"],
        "properties": {
          "claim": {"type": "string"},
          "type": {"enum": ["fact", "interpretation", "value", "forecast"]},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "tradeoffs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "counterarguments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "argument": {"type": "string"},
          "strength": {"type": "number", "minimum": 0, "maximum": 1},
          "response": {"type": "string"}
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {"type": "string"}
    },
    "change_conditions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "url", "source_type"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "url": {"type": "string"},
          "source_type": {
            "enum": ["official", "party", "association", "ngo", "research", "media", "other"]
          },
          "published_at": {"type": ["string", "null"]},
          "notes": {"type": "string"}
        }
      }
    },
    "reveal": {
      "type": "object",
      "properties": {
        "political_origins": {
          "type": "array",
          "items": {"type": "string"}
        },
        "source_mix_explanation": {"type": "string"},
        "synthetic_persona_disclaimer": {"type": "string"}
      }
    }
  }
}
